# ~/.config/dev/local.env のテンプレート。
# マシン固有・機密情報を含むため、このファイル自体はGit管理しない
# (install.sh が初回のみこの内容をコピーする)。

DEV_SERVER_HOST=dev-server         # ~/.ssh/config.local で定義したHost名
DEV_SERVER_MAC=00:11:22:33:44:55   # Development Server 管理NIC(1GbE)のMACアドレス
RASPI_HOST=raspi                   # ~/.ssh/config.local で定義したHost名

DEFAULT_EDITOR=zed
DEV_SERVER_WAIT_TIMEOUT=180        # Wake後にSSH起動を待つ最大秒数
DEV_IDLE_TIMEOUT=3600              # Development Server側 自動Suspendまでのidle秒数

# 私用秘書 (docs/secretary.md)。認証情報はコンテナ内で設定する。
SECRETARY_HOST=secretary-dev
SECRETARY_INSTANCE=secretary-dev
SECRETARY_TUNNEL_TTL=14400

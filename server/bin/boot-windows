#!/usr/bin/env bash
# 次回の起動だけWindowsにする。Windowsをシャットダウンして再度起動すれば、Debianに戻る。
#
#   boot-windows       次回だけWindowsに設定し、確認してから再起動
#   boot-windows -n    設定だけ (再起動しない)
#   boot-windows -y    確認なしで再起動
#
# 実体は GRUB の grub-reboot。記録先は /boot/grub/grubenv (ディスク上のファイル) なので、
# UEFI変数 (NVRAM) に書かない。このサーバーはSuspend復帰後にNVRAMへ書けなくなる
# (efibootmgr -n が EIO) ため、BootNext方式ではなくこちらを使う。docs/windows.md 参照。
# 前提: sudo ./server/grub/setup-windows.sh 済み。
set -euo pipefail

ENTRY_ID="windows"

sudo grep -q -- "--id $ENTRY_ID" /boot/grub/grub.cfg 2>/dev/null || {
  echo "boot-windows: GRUBに $ENTRY_ID エントリがありません。" >&2
  echo "  sudo ./server/grub/setup-windows.sh を実行してください。" >&2
  exit 1
}

sudo grub-reboot "$ENTRY_ID"
echo "次回起動: Windows (GRUB: $ENTRY_ID)"

case "${1:-}" in
  -n) exit 0 ;;
  -y) ;;
  *)
    read -r -p "今すぐ再起動しますか? [y/N] " answer
    [ "$answer" = y ] || exit 0
    ;;
esac

exec sudo systemctl reboot

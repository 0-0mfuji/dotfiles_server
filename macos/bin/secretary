#!/usr/bin/env bash
# 私用秘書への接続。Zedや開発用エージェントの設定は実行しない。
set -euo pipefail
resolve_repo_root() {
  local src="${BASH_SOURCE[0]}" dir
  while [ -h "$src" ]; do
    dir="$(cd -P "$(dirname "$src")" && pwd)"
    src="$(readlink "$src")"
    [[ "$src" != /* ]] && src="$dir/$src"
  done
  cd -P "$(dirname "$src")/../.." && pwd
}
REPO_ROOT="$(resolve_repo_root)"
# shellcheck source=../../scripts/lib.sh
source "$REPO_ROOT/scripts/lib.sh"
usage() {
  cat <<'HELP'
Usage: secretary [launch|mobile|nanomuse|hermes|notes|web|chat|setup [model|gmail|outlook|plane|karakeep|gateway]|status|doctor|notes-config|timetree-config|timetree-calendars]
  launch          dev secretary と同じ（既定）。未設定項目を案内してNanoMuseを開く
  mobile          スマホブラウザ用のQRコードを表示
  nanomuse        NanoMuseを開く
  hermes          Hermesの画面を開く
  notes           SilverBulletをブラウザで開く
  web             NanoMuseの画面をブラウザで開く
  chat / setup    Webで会話 / 対話設定
  status          接続・コンテナ状態のみ確認（起動しない）
  doctor          連携先の接続テスト（メール本文は出力しない）
  notes-config    SilverBulletのログイン設定
  timetree-calendars 有効なカレンダーのIDと名前を表示
  timetree-config TimeTreeの共有予定取得設定
設定: ~/.config/dev/local.env の SECRETARY_HOST / SECRETARY_INSTANCE
HELP
}
case "${1:-}" in -h|--help|help) usage; exit 0 ;; esac
command="${1:-launch}"
section="${2:-}"
case "$command" in launch|mobile|nanomuse|hermes|notes|web|chat|setup|status|doctor|notes-config|timetree-config|timetree-calendars) ;; *) usage >&2; exit 2 ;; esac
case "$section" in ''|model|gmail|outlook|plane|karakeep|gateway|notes|timetree) ;; *) usage >&2; exit 2 ;; esac
[ "$command" = setup ] || [ -z "$section" ] || { usage >&2; exit 2; }
if [ "$command" = setup ] && { [ "$section" = model ] || [ "$section" = gateway ]; }; then
  exec "$REPO_ROOT/macos/bin/dev" --web secretary
fi
case "$command" in
  launch) exec "$REPO_ROOT/macos/bin/dev" secretary ;;
  mobile) exec "$REPO_ROOT/macos/bin/dev" --mobile secretary ;;
  nanomuse) exec "$REPO_ROOT/macos/bin/dev" --nanomuse secretary ;;
  hermes) exec "$REPO_ROOT/macos/bin/dev" --hermes secretary ;;
  notes) exec "$REPO_ROOT/macos/bin/dev" --preview secretary ;;
  chat) exec "$REPO_ROOT/macos/bin/dev" --web secretary ;;
  web) exec "$REPO_ROOT/macos/bin/dev" --web secretary ;;
esac
load_local_env
host="${SECRETARY_HOST:-secretary-dev}"
instance="${SECRETARY_INSTANCE:-secretary-dev}"
server="${DEV_SERVER_HOST:-dev-server}"
for value in "$host" "$instance" "$server"; do
  [[ "$value" =~ ^[a-zA-Z0-9][a-zA-Z0-9._-]*$ ]] || { err 'SSH alias / instance名が不正です'; exit 2; }
done
if [ "$command" = status ]; then
  "$REPO_ROOT/scripts/server-status" "$server" || exit 1
  ssh "$server" "incus list '$instance' -c ns -f csv"
  exit
fi
if ! "$REPO_ROOT/scripts/server-status" "$server"; then
  "$REPO_ROOT/scripts/server-wake"
  ready=0
  for _ in $(seq 1 30); do
    if "$REPO_ROOT/scripts/server-status" "$server" 2; then ready=1; break; fi
    sleep 2
  done
  [ "$ready" -eq 1 ] || { err 'サーバーへ接続できません'; exit 1; }
fi
"$REPO_ROOT/scripts/remote-start" "$server" "$instance"
case "$command" in
  notes-config|timetree-config) ssh -t "$host" "sudo /usr/local/bin/secretary '$command'" ;;
  timetree-calendars) ssh "$host" 'sudo -H -u secretary /usr/local/bin/secretary timetree-calendars' ;;
  doctor) ssh -t "$host" 'sudo -H -u secretary /usr/local/bin/secretary doctor --check' ;;
  *)
    if [ "$command" = setup ] && { [ "$section" = gmail ] || [ "$section" = outlook ]; }; then
      ssh -t -o ControlMaster=no -o ControlPath=none -o ExitOnForwardFailure=yes -L 8765:127.0.0.1:8765 "$host" \
        "sudo -H -u secretary env SECRETARY_OAUTH_TUNNEL=1 /usr/local/bin/secretary setup '$section'"
    else
      ssh -t "$host" "sudo -H -u secretary /usr/local/bin/secretary '$command' ${section:+'$section'}"
    fi
    ;;
esac

if [ "$command" = setup ]; then
  ssh "$host" 'sudo systemctl try-restart secretary-nanomuse.service' || true
fi

#!/usr/bin/env bash
# dev - Development Serverの状態確認・Wake・Remote Environment起動・
#       Zed Remote Developmentでのプロジェクトオープンを自動化するlauncher。
#
# Usage: dev [--zed] [--web] [--preview] [--mobile] [--login | --no-login] <target> [project]
#   既定ではZed、DeepSeek HarnessのWeb UI、スマホ用のQRコード、(設定があれば) 開発サーバーのプレビュー (Remotion Studio / Vite) を出す。
#   target一覧は config/projects.conf を参照。
set -euo pipefail

resolve_repo_root() {
  local src="${BASH_SOURCE[0]}"
  while [ -h "$src" ]; do
    local dir
    dir="$(cd -P "$(dirname "$src")" && pwd)"
    src="$(readlink "$src")"
    [[ "$src" != /* ]] && src="$dir/$src"
  done
  cd -P "$(dirname "$src")/../.." && pwd
}

REPO_ROOT="$(resolve_repo_root)"
# shellcheck source=../../scripts/lib.sh
source "$REPO_ROOT/scripts/lib.sh"

usage() {
  cat <<EOF
Usage: dev [options] <target> [project]

  dev os sota   target "os" の中の、プロジェクト "sota" を開く
  dev os        プロジェクトが複数あれば、番号で選ぶ (1つだけなら、そのまま開く。対話できないときは先頭)
  dev lang      プロジェクトを分けていない target は、そのまま指定する
  dev secretary 秘書の未設定項目を案内し、NanoMuseを開く (Zedなし)

Options:
  --zed         Zedを開く
  --nanomuse    secretary専用: NanoMuseを開く（既定）
  --hermes      secretary専用: Hermesの画面を開く
  --web         DeepSeek HarnessのWeb UIを開く (スマホ用のQRコードも表示する)
  --preview     開発サーバー (Remotion Studio / Vite / Storybook / Flutter Web / Zola) を開く (projects.conf の preview列がある target だけ。--studio も同じ)
  --mobile      スマホ用のQRコードだけを表示する (Zedもブラウザも開かない)
  (指定なし)    Zed、Web UI、QRコード、プレビューのすべて
  (secretary)   既定と--web はNanoMuse。--mobileはスマホQR、--previewはSilverBullet、--hermesは旧Hermes
  (複数指定)    指定したものだけ (例: --zed --mobile)
  --login       ログインをスキップ設定を無視して案内する (secretaryでは秘書の連携設定)
  --no-login    ログイン状況の確認を行わない

Targets are defined in: $REPO_ROOT/config/projects.conf
EOF
}

target=""; project=""; only_zed=0; only_web=0; only_preview=0; only_mobile=0; force_login=0; check_login=1; secretary_backend=nanomuse; backend_explicit=0
while [ $# -gt 0 ]; do
  case "$1" in
    --nanomuse|--hermes)
      [ "$backend_explicit" = 0 ] || { err '--nanomuse / --hermes は一方だけ指定してください'; exit 2; }
      secretary_backend="${1#--}"; backend_explicit=1; only_web=1 ;;
    --zed) only_zed=1 ;;
    --web) only_web=1 ;;
    --preview|--studio) only_preview=1 ;;
    --mobile) only_mobile=1 ;;
    --login) force_login=1 ;;
    --no-login) check_login=0 ;;
    -h|--help) usage; exit 0 ;;
    -*) err "unknown option: $1"; usage; exit 1 ;;
    *) if [ -z "$target" ]; then target="$1"
       elif [ -z "$project" ]; then project="$1"
       else err "unexpected argument: $1"; exit 1; fi ;;
  esac
  shift
done
if [ -z "$target" ]; then
  usage
  exit 1
fi
if [ "$only_zed" = 0 ] && [ "$only_web" = 0 ] && [ "$only_preview" = 0 ] && [ "$only_mobile" = 0 ]; then
  want_zed=1; want_web=1; want_preview=1; want_mobile=1
else
  want_zed=$only_zed; want_web=$only_web; want_preview=$only_preview; want_mobile=$only_mobile
  [ "$only_web" = 1 ] && want_mobile=1   # Web UIを開くときは、QRコードも出す
fi

load_local_env

# "dev os sota" / "dev os" / "dev lang" から、projects.conf のキーを1つに決める
key="$(resolve_target "$target" "$project")" || exit 1
[ "$key" != "$target" ] && log "target: $key"

if ! IFS=' ' read -r remote_host remote_path instance repo vcs deps preview workflow < <(lookup_target "$key"); then
  err "unknown target: $key"
  exit 1
fi

# 秘書は共通のWake/起動処理を使い、開く画面と設定案内だけ切り替える。
case "$workflow" in
  development|-)
    [ "$backend_explicit" = 0 ] || { err '--nanomuse / --hermes はsecretary専用です'; exit 2; }
    ;;
  secretary)
    if [ "$only_zed" = 1 ] || { [ "$only_mobile" = 1 ] && [ "$secretary_backend" != nanomuse ]; }; then
      err "secretaryで--zedは使えません。--mobileはNanoMuse専用です"
      exit 2
    fi
    if [ "$only_zed$only_web$only_preview$only_mobile" = 0000 ]; then
      want_preview=0
    fi
    ;;
  *) err "unknown workflow: $workflow"; exit 2 ;;
esac

: "${DEV_SERVER_HOST:?DEV_SERVER_HOST is not set (see ~/.config/dev/local.env)}"

WAIT_TIMEOUT="${DEV_SERVER_WAIT_TIMEOUT:-180}"
POLL_INTERVAL=5

log "checking development server ($DEV_SERVER_HOST) ..."
if ! "$REPO_ROOT/scripts/server-status" "$DEV_SERVER_HOST" 3; then
  log "development server unreachable, requesting wake-on-LAN"
  "$REPO_ROOT/scripts/server-wake"

  log "waiting for development server to come up (timeout: ${WAIT_TIMEOUT}s)"
  elapsed=0
  until "$REPO_ROOT/scripts/server-status" "$DEV_SERVER_HOST" 3; do
    if [ "$elapsed" -ge "$WAIT_TIMEOUT" ]; then
      err "development server did not come up within ${WAIT_TIMEOUT}s"
      exit 1
    fi
    sleep "$POLL_INTERVAL"
    elapsed=$((elapsed + POLL_INTERVAL))
  done
fi
log "development server is up"

# 依存するコンテナ (例: video が呼ぶ voice) を、本体より先に起動する。停止はしない (他のtargetと共有するため)
if [ "$deps" != "-" ]; then
  for dep in ${deps//,/ }; do
    "$REPO_ROOT/scripts/remote-start" "$DEV_SERVER_HOST" "$dep"
  done
fi
if [ -n "$instance" ] && [ "$instance" != "-" ]; then
  "$REPO_ROOT/scripts/remote-start" "$DEV_SERVER_HOST" "$instance"
fi

log "checking target host ($remote_host) ..."
if ! "$REPO_ROOT/scripts/server-status" "$remote_host" 5; then
  err "cannot reach target host: $remote_host"
  exit 1
fi

if [ "$workflow" = secretary ]; then
  DEV_FORCE_LOGIN="$force_login" DEV_SECRETARY_CHECK="$check_login" \
    "$REPO_ROOT/scripts/secretary-launch" "$remote_host" "$want_web" "$want_preview" "$secretary_backend" "$want_mobile" "$only_mobile"
  exit
fi

if { [ -n "$repo" ] && [ "$repo" != "-" ]; } || [ "$vcs" = jj ]; then
  "$REPO_ROOT/scripts/project-clone" "$remote_host" "$remote_path" "${repo:--}" "${vcs:-git}"
fi

# ログイン状況の案内とWeb UIは、失敗しても処理を止めない
# --mobile だけのときは、ログインの案内も省く
if [ "$check_login" = 1 ] && [ "${DEV_AGENT_CHECK:-on}" != off ] && { [ "$want_zed" = 1 ] || [ "$want_web" = 1 ]; }; then
  DEV_FORCE_LOGIN="$force_login" "$REPO_ROOT/scripts/agent-login" "$remote_host" || true
fi
if [ "$want_web" = 1 ]; then
  "$REPO_ROOT/scripts/open-web" "$remote_host" || true
fi
if [ "$want_preview" = 1 ] && [ "$preview" != "-" ]; then
  IFS=',' read -r -a preview_specs <<< "$preview"
  for preview_spec in "${preview_specs[@]}"; do
    "$REPO_ROOT/scripts/open-preview" "$remote_host" "$remote_path" "$preview_spec" || true
  done
fi
if [ "$want_mobile" = 1 ]; then
  "$REPO_ROOT/scripts/show-mobile-qr" "$remote_host" "$only_mobile" || true
fi
if [ "$want_zed" = 1 ]; then
  exec "$REPO_ROOT/scripts/open-project" "$remote_host" "$remote_path"
fi

#!/usr/bin/env bash
# dev - Development Serverの状態確認・Wake・Remote Environment起動・
#       Zed Remote Developmentでのプロジェクトオープンを自動化するlauncher。
#
# Usage: dev [--zed | --web] [--login | --no-login] <target>
#   既定ではZedとDeepSeek HarnessのWeb UIの両方を開く。
#   target一覧は config/projects.conf を参照。
set -euo pipefail

resolve_repo_root() {
  local src="${BASH_SOURCE[0]}"
  while [ -h "$src" ]; do
    local dir
    dir="$(cd -P "$(dirname "$src")" && pwd)"
    src="$(readlink "$src")"
    [[ "$src" != /* ]] && src="$dir/$src"
  done
  cd -P "$(dirname "$src")/../.." && pwd
}

REPO_ROOT="$(resolve_repo_root)"
# shellcheck source=../../scripts/lib.sh
source "$REPO_ROOT/scripts/lib.sh"

usage() {
  cat <<EOF
Usage: dev [options] <target>

Options:
  --zed         Zedだけを開く
  --web         DeepSeek HarnessのWeb UIだけを開く
  (指定なし)    Zedと Web UI の両方を開く
  --login       Claude Code / Codex のログインを、スキップ設定を無視して案内する
  --no-login    ログイン状況の確認を行わない

Targets are defined in: $REPO_ROOT/config/projects.conf
EOF
}

target=""; only_zed=0; only_web=0; force_login=0; check_login=1
while [ $# -gt 0 ]; do
  case "$1" in
    --zed) only_zed=1 ;;
    --web) only_web=1 ;;
    --login) force_login=1 ;;
    --no-login) check_login=0 ;;
    -h|--help) usage; exit 0 ;;
    -*) err "unknown option: $1"; usage; exit 1 ;;
    *) if [ -z "$target" ]; then target="$1"; else err "unexpected argument: $1"; exit 1; fi ;;
  esac
  shift
done
if [ -z "$target" ]; then
  usage
  exit 1
fi
want_zed=1; want_web=1
if [ "$only_zed" = 1 ] || [ "$only_web" = 1 ]; then want_zed=$only_zed; want_web=$only_web; fi

load_local_env

if ! IFS=' ' read -r remote_host remote_path instance repo < <(lookup_target "$target"); then
  err "unknown target: $target"
  exit 1
fi

: "${DEV_SERVER_HOST:?DEV_SERVER_HOST is not set (see ~/.config/dev/local.env)}"

WAIT_TIMEOUT="${DEV_SERVER_WAIT_TIMEOUT:-180}"
POLL_INTERVAL=5

log "checking development server ($DEV_SERVER_HOST) ..."
if ! "$REPO_ROOT/scripts/server-status" "$DEV_SERVER_HOST" 3; then
  log "development server unreachable, requesting wake-on-LAN"
  "$REPO_ROOT/scripts/server-wake"

  log "waiting for development server to come up (timeout: ${WAIT_TIMEOUT}s)"
  elapsed=0
  until "$REPO_ROOT/scripts/server-status" "$DEV_SERVER_HOST" 3; do
    if [ "$elapsed" -ge "$WAIT_TIMEOUT" ]; then
      err "development server did not come up within ${WAIT_TIMEOUT}s"
      exit 1
    fi
    sleep "$POLL_INTERVAL"
    elapsed=$((elapsed + POLL_INTERVAL))
  done
fi
log "development server is up"

if [ -n "$instance" ] && [ "$instance" != "-" ]; then
  "$REPO_ROOT/scripts/remote-start" "$DEV_SERVER_HOST" "$instance"
fi

log "checking target host ($remote_host) ..."
if ! "$REPO_ROOT/scripts/server-status" "$remote_host" 5; then
  err "cannot reach target host: $remote_host"
  exit 1
fi

if [ -n "$repo" ] && [ "$repo" != "-" ]; then
  "$REPO_ROOT/scripts/project-clone" "$remote_host" "$remote_path" "$repo"
fi

# ログイン状況の案内とWeb UIは、失敗しても処理を止めない
if [ "$check_login" = 1 ] && [ "${DEV_AGENT_CHECK:-on}" != off ]; then
  DEV_FORCE_LOGIN="$force_login" "$REPO_ROOT/scripts/agent-login" "$remote_host" || true
fi
if [ "$want_web" = 1 ]; then
  "$REPO_ROOT/scripts/open-web" "$remote_host" || true
fi
if [ "$want_zed" = 1 ]; then
  exec "$REPO_ROOT/scripts/open-project" "$remote_host" "$remote_path"
fi

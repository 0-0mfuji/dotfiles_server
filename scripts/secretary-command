#!/usr/bin/env bash
# dev secretary の設定・診断。Wakeと接続確認はdevが行う。
set -euo pipefail
host="${1:?missing host}"; action="${2:?missing action}"; section="${3:-}"
[[ "$host" =~ ^[a-zA-Z0-9][a-zA-Z0-9._-]*$ ]] || exit 2
case "$action" in
  doctor) exec ssh -t "$host" 'sudo -H -u secretary /usr/local/bin/secretary doctor --check' ;;
  timetree-calendars) exec ssh "$host" 'sudo -H -u secretary /usr/local/bin/secretary timetree-calendars' ;;
  setup)
    case "$section" in
      notes) exec ssh -t "$host" 'sudo /usr/local/bin/secretary notes-config' ;;
      timetree) exec ssh -t "$host" 'sudo /usr/local/bin/secretary timetree-config' ;;
      ''|gmail|outlook)
        ssh -t -o ControlMaster=no -o ControlPath=none -o ExitOnForwardFailure=yes -L 8765:127.0.0.1:8765 "$host" \
          "sudo -H -u secretary env SECRETARY_OAUTH_TUNNEL=1 /usr/local/bin/secretary setup '$section'" ;;
      plane|karakeep) ssh -t "$host" "sudo -H -u secretary /usr/local/bin/secretary setup '$section'" ;;
      *) exit 2 ;;
    esac
    ssh "$host" 'sudo systemctl try-restart secretary-nanomuse.service'
    ;;
  *) exit 2 ;;
esac

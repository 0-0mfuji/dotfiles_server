#!/usr/bin/env bash
# Claude Code / Codex / GitHub CLI のログイン状況を表示し、未ログインなら順にログインを案内する。
# 契約していない期間もあるため、ログインしなくても処理は止めずに先へ進む。
#
# Usage: agent-login <ssh-host> [all|gh|secretary-gh]
# 環境変数:
#   DEV_AGENT_CHECK=off            確認そのものを行わない
#   DEV_SKIP_AGENTS="claude codex gh" 指定したツールを確認しない
#   DEV_FORCE_LOGIN=1              「今後聞かない」の設定を無視して案内する (dev --login)
set -uo pipefail

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=./lib.sh
source "$DIR/lib.sh"

host="${1:?usage: agent-login <ssh-host> [all|gh|secretary-gh]}"
scope="${2:-all}"
[[ "$host" =~ ^[a-zA-Z0-9][a-zA-Z0-9._-]*$ ]] || exit 2
case "$scope" in
  all) candidates=(claude codex gh) ;;
  gh|secretary-gh) candidates=(gh) ;;
  *) exit 2 ;;
esac
[ "${DEV_AGENT_CHECK:-on}" = off ] && exit 0

skip_dir="$HOME/.config/dev/skip-login"
gh_command=gh
if [ "$scope" = secretary-gh ]; then gh_command='sudo -n -H -u secretary /usr/bin/gh'; fi

label()     { case "$1" in claude) echo "Claude Code" ;; codex) echo "Codex" ;; gh) echo "GitHub CLI" ;; esac; }
login_cmd() { case "$1" in claude) echo "claude auth login" ;; codex) echo "codex login --device-auth" ;; gh) echo "$gh_command auth login --hostname github.com" ;; esac; }

# yes | no | invalid | missing | unknown
remote_status() {
  local output status
  case "$1" in
    claude) ssh -o BatchMode=yes "$host" 'command -v claude >/dev/null 2>&1 || { echo missing; exit 0; }; claude auth status 2>/dev/null | grep -q "\"loggedIn\": true" && echo yes || echo no' 2>/dev/null ;;
    codex)  ssh -o BatchMode=yes "$host" 'command -v codex >/dev/null 2>&1 || { echo missing; exit 0; }; codex login status >/dev/null 2>&1 && echo yes || echo no' 2>/dev/null ;;
    gh)
      output="$(ssh -o BatchMode=yes "$host" "command -v gh >/dev/null 2>&1 || exit 127; NO_COLOR=1 $gh_command auth status --hostname github.com 2>&1" 2>/dev/null)"
      status=$?
      case "$status" in
        0) echo yes ;;
        127) echo missing ;;
        1|4)
          case "$output" in
            *'The token in '*' is invalid.'*|*'Refresh token for '*' was rejected'*) echo invalid ;;
            *'not logged into'*|*'have not logged in'*|*'To get started with GitHub CLI'*) echo no ;;
            *) echo unknown ;;
          esac ;;
        *) echo unknown ;;
      esac ;;
  esac
}

skip_file() {
  if [ "$1" = gh ]; then
    printf '%s/hosts/%s/gh\n' "$skip_dir" "$host"
  else
    printf '%s/%s\n' "$skip_dir" "$1"
  fi
}

is_skipped() {
  [[ " ${DEV_SKIP_AGENTS:-} " == *" $1 "* ]] && return 0
  [ "$1" = gh ] && return 1  # 保存済みトークンの無効化は、案内を省く設定があっても確認する。
  [ "${DEV_FORCE_LOGIN:-0}" = 1 ] && return 1
  [ -e "$(skip_file "$1")" ]
}

tools=()
for t in "${candidates[@]}"; do is_skipped "$t" || tools+=("$t"); done
[ "${#tools[@]}" -gt 0 ] || exit 0

summary=""; pending=()
for t in "${tools[@]}"; do
  st="$(remote_status "$t")"; st="${st:-unknown}"
  case "$st" in
    yes)     summary+="$(label "$t"): ログイン済み  " ;;
    no)
      if [ "$t" = gh ]; then
        summary+="$(label "$t"): 未ログイン  "
        if [ "${DEV_FORCE_LOGIN:-0}" != 1 ] && [ -e "$(skip_file "$t")" ]; then continue; fi
      else
        summary+="$(label "$t"): 未ログイン  "
      fi
      pending+=("$t")
      ;;
    invalid)
      summary+="$(label "$t"): トークンが無効 (期限切れ・失効等)  "
      pending+=(gh)
      gh_invalid=1
      ;;
    missing) summary+="$(label "$t"): 未導入  " ;;
    *)       summary+="$(label "$t"): 確認できません  " ;;
  esac
done
log "$host: $summary"

[ "${#pending[@]}" -gt 0 ] || exit 0
if [ "${gh_invalid:-0}" = 1 ]; then
  log "GitHub CLI の再認証が必要です。Mac のターミナルで dev <target> を開くと再認証できます。"
fi
# 対話できない環境では案内せず、状況の表示だけで進む
{ [ -t 0 ] && [ -t 1 ]; } || exit 0

for t in "${pending[@]}"; do
  if [ "$t" = gh ] && [ "${gh_invalid:-0}" = 1 ]; then
    printf '[dev] GitHub CLI を再認証しますか? [y=今する / Enter=今回は進む] ' >&2
  else
    printf '[dev] %s にログインしますか? [y=今する / Enter=今回は進む / s=今後聞かない] ' "$(label "$t")" >&2
  fi
  read -r ans < /dev/tty || ans=""
  case "$ans" in
    y|Y)
      if [ "$t" = gh ]; then
        log "個人リポジトリ用の Fine-grained PAT 作成画面をMacで開きます。"
        # GitHub公式のテンプレートURL。Repository access の指定は未対応なので画面で選ぶ。
        github_token_url="https://github.com/settings/personal-access-tokens/new?name=dev-container&target_name=0-0mfuji&expires_in=30&contents=write&pull_requests=write&issues=write"
        log "入力済み: owner=0-0mfuji / 期限=30日 / Contents・Pull requests・Issues=Read and write"
        log "Repository access は All repositories を選んでください (個人所有の Private・Public)。"
        log "作成前に所有者が 0-0mfuji であることを確認してください。"
        log "続く gh の認証方法では Paste an authentication token を選び、作成したトークンを入力してください。"
        log "トークンはこのターミナルの gh の入力欄だけに貼り付けてください。"
        if ! open "$github_token_url"; then
          log "$github_token_url を手動で開いてください。"
        fi
      fi
      ssh -t "$host" "$(login_cmd "$t")" || true
      if [ "$(remote_status "$t")" = yes ]; then
        log "$(label "$t"): ログインしました"
        if [ "$t" = gh ]; then rm -f "$(skip_file "$t")"; fi
      else
        log "$(label "$t"): ログインできていません (このまま進みます)"
      fi
      ;;
    s|S)
      if [ "$t" = gh ] && [ "${gh_invalid:-0}" = 1 ]; then continue; fi
      file="$(skip_file "$t")"
      mkdir -p "$(dirname "$file")"; : > "$file"
      log "$(label "$t"): 今後聞きません (再開: dev --login <target> または rm $file)"
      ;;
    *) ;;
  esac
done
exit 0

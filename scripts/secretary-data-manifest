#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""Prepare a private rsync file list + checksums. Never moves or deletes source data."""
import argparse
import hashlib
import json
import os
from pathlib import Path
import subprocess

ROOTS = {'data', 'state', 'epub_out', 'epub_old', 'epub_test', 'oald_dl'}
BOOKS = {'cache', 'final', 'luna', 'test_zh'}


def selected(name):
    path = Path(name)
    parts = path.parts
    if not parts or path.is_absolute() or '..' in parts:
        return False
    if any(p in {'.git', '.venv', 'venv', 'node_modules', '__pycache__', '.ssh', '.config'}
           or p.startswith('.') or p.endswith('-venv')
           or p in {'credentials.json', 'connections.json', 'tool-secrets.json', 'cookies.json', 'auth.json', 'vault.enc', 'vault.key'}
           for p in parts):
        return False
    if path.suffix.lower() in {'.py', '.sh', '.swift', '.java', '.js', '.cjs', '.mjs', '.log', '.pyc'}:
        return False
    if parts[0] in ROOTS:
        return True
    if parts[0] == 'books' and len(parts) > 1:
        return parts[1] in BOOKS or parts[1].startswith('out') or path.suffix in {'.epub', '.zip', '.jsonl'}
    if parts[0] == 'tools':
        return any(x in {'state', 'output', 'epub_out'} for x in parts[1:-1])
    # Legacy files at the root; excludes programs, credentials and unrelated projects.
    return len(parts) == 1 and (path.suffix.lower() in {'.epub', '.dict', '.idx', '.ifo', '.dz', '.txt', '.json', '.jsonl', '.csv'}
                               or path.name.startswith('wadokudict_') or path.name == 'german-dict.zip')


def build(repo, output):
    repo, output = Path(repo).resolve(), Path(output).resolve()
    output.mkdir(parents=True, exist_ok=False, mode=0o700)
    names = subprocess.check_output(['git', '-C', str(repo), 'ls-files', '--others', '--ignored', '--exclude-standard', '-z'])
    manifest = []
    for raw in names.split(b'\0'):
        if not raw:
            continue
        name = os.fsdecode(raw)
        path = repo / name
        if not selected(name) or path.is_symlink() or not path.is_file() or not path.resolve().is_relative_to(repo):
            continue
        digest = hashlib.sha256()
        with path.open('rb') as stream:
            for block in iter(lambda: stream.read(4 * 1024 * 1024), b''):
                digest.update(block)
        manifest.append({'path': name, 'size': path.stat().st_size, 'sha256': digest.hexdigest()})
    (output / 'files.nul').write_bytes(b''.join(os.fsencode(x['path']) + b'\0' for x in manifest))
    (output / 'manifest.json').write_text(json.dumps(manifest, ensure_ascii=False, indent=2))
    for path in output.iterdir():
        path.chmod(0o600)
    print(f'{len(manifest)} files; {sum(x["size"] for x in manifest):,} bytes')
    print('Private transfer list:', output)
    print('No source files were changed. Credentials, programs, virtualenvs and nested repositories are excluded.')


if __name__ == '__main__':
    parser = argparse.ArgumentParser()
    parser.add_argument('repository')
    parser.add_argument('output_directory', help='new private directory outside the repository')
    args = parser.parse_args()
    build(args.repository, args.output_directory)

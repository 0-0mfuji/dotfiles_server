#!/usr/bin/env bash
# devが共通のWake/コンテナ起動を終えた後、秘書の設定案内と画面を開く。
set -euo pipefail
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=./lib.sh
source "$DIR/lib.sh"
host="${1:?usage: secretary-launch <ssh-host> <web:0|1> <notes:0|1>}"
web="${2:-1}"; notes="${3:-1}"; backend="${4:-nanomuse}"; mobile="${5:-0}"; explicit_mobile="${6:-0}"
[[ "$host" =~ ^[a-zA-Z0-9][a-zA-Z0-9._-]*$ ]] || { err 'SSH aliasが不正です'; exit 2; }
case "$backend" in hermes|nanomuse) ;; *) err 'unknown secretary backend'; exit 2 ;; esac
if [ "$backend" = nanomuse ]; then
  if ! ssh -o BatchMode=yes "$host" 'test -x /opt/nanomuse/current/.venv/bin/nanomuse'; then
    err 'NanoMuseは未導入です。サーバーで secretary/provision secretary-dev nanomuse を実行してください'
    exit 1
  fi
  # 停止中なら起動する。会話中のサービスは再起動しない。
  ssh "$host" 'sudo systemctl start secretary-nanomuse.service'
  log 'NanoMuseのモデル変更: Settings → Connections'
  log 'Web UIは英語/中国語、AIの返答は日本語です。文書はLibraryで確認できます'
fi
if ! ssh -o BatchMode=yes "$host" 'test -x /usr/local/bin/secretary'; then
  err '秘書のツールが未導入です。サーバーで dotfile_infra/secretary/provision secretary-dev を実行してください'
  exit 1
fi
if [ "$backend" = hermes ] && [ "$web" = 1 ]; then
  ssh "$host" 'sudo systemctl start secretary-hermes.service'
fi
if { [ "$web" = 1 ] || [ "$notes" = 1 ]; } && [ "${DEV_SECRETARY_CHECK:-1}" = 1 ] && [ "${DEV_AGENT_CHECK:-on}" != off ]; then
  # 値は機密情報を含まない固定名・状態・表示名だけ。ネットワーク接続テストはdoctorで行う。
  statuses="$(ssh -o BatchMode=yes "$host" 'sudo -H -u secretary /usr/local/bin/secretary readiness')" || {
    err '秘書の設定状態を取得できません。secretary/provision を再実行してください'
    exit 1
  }
  pending=()
  while IFS=$'\t' read -r section state label; do
    if [ "$backend" = nanomuse ]; then
      case "$section" in gateway) continue ;; notes) [ "$notes" = 1 ] || continue ;; esac
    fi
    if [ "$backend" = nanomuse ] && [ "$section" = model ]; then continue; fi
    if [ "$section" = nanomuse-model ]; then
      [ "$backend" = nanomuse ] || continue
      log "$label: $state"
      continue
    fi
    case "$section" in model|notes|gmail|outlook|plane|karakeep|timetree|gateway) ;; *) continue ;; esac
    if [ "$state" = ready ]; then log "$label: 設定済み"; else log "$label: 未設定・停止中"; fi
    [ "$state" = pending ] && pending+=("$section")
  done <<< "$statuses"
  skip_dir="$HOME/.config/dev/skip-secretary/$host"
  if [ -t 0 ] && [ -t 1 ]; then
    for section in "${pending[@]}"; do
      if [ "${DEV_FORCE_LOGIN:-0}" != 1 ] && [ -e "$skip_dir/$section" ]; then continue; fi
      printf '[dev] %s を設定しますか? [y=今する / Enter=今回は進む / s=今後聞かない] ' "$section" >&2
      read -r answer < /dev/tty || answer=''
      case "$answer" in
        y|Y)
          case "$section" in
            notes) ssh -t "$host" 'sudo /usr/local/bin/secretary notes-config' || true ;;
            timetree) ssh -t "$host" 'sudo /usr/local/bin/secretary timetree-config' || true ;;
            gmail|outlook)
              # OAuthのlocalhost callbackをMacへ転送。秘密情報をコマンド引数には含めない。
              ssh -t -o ControlMaster=no -o ControlPath=none -o ExitOnForwardFailure=yes -L 8765:127.0.0.1:8765 "$host" \
                "sudo -H -u secretary env SECRETARY_OAUTH_TUNNEL=1 /usr/local/bin/secretary setup '$section'" || true
              ;;
            gateway)
              if ssh -t "$host" 'sudo -H -u secretary /usr/local/bin/secretary setup gateway'; then
                ssh "$host" 'sudo systemctl enable --now secretary-gateway.service' || true
              fi
              ;;
            *) ssh -t "$host" "sudo -H -u secretary /usr/local/bin/secretary setup '$section'" || true ;;
          esac
          # 失敗やスキップを設定済みと記録しない。次の起動でも実際の状態を確認する。
          ssh "$host" 'sudo systemctl try-restart secretary-hermes.service secretary-gateway.service secretary-nanomuse.service' || true
          ;;
        s|S) mkdir -p "$skip_dir"; : > "$skip_dir/$section" ;;
      esac
    done
  fi
  log '再設定: dev --login secretary / 個別設定: secretary setup / 接続確認: secretary doctor'
fi
open_ui() {
  local remote_port="$1" first_port="$2" title="$3" code port url token attempt
  code="$(ssh -o BatchMode=yes "$host" "curl --max-time 5 -s -o /dev/null -w '%{http_code}' http://127.0.0.1:$remote_port/" || true)"
  if [ "$title" = NanoMuse ]; then
    for attempt in 1 2 3 4 5; do
      case "$code" in 200) break ;; esac
      sleep 1
      code="$(ssh -o BatchMode=yes "$host" "curl --max-time 5 -s -o /dev/null -w '%{http_code}' http://127.0.0.1:$remote_port/" || true)"
    done
  fi
  case "$code" in
    200|301|302|303|307|308|401|403) ;;
    *) err "$title は未起動です (設定やサービスの状態を確認してください)"; return 1 ;;
  esac
  port="$(ensure_tunnel "$host" "$remote_port" "$first_port" "${SECRETARY_TUNNEL_TTL:-14400}")" || return 1
  url="http://127.0.0.1:$port/"
  if [ "$title" = NanoMuse ]; then
    token="$(ssh -o BatchMode=yes "$host" 'sudo -H -u secretary cat /home/secretary/.nanomuse/server_token')" || return 1
    [[ "$token" =~ ^[a-zA-Z0-9_-]+$ ]] || { err 'NanoMuseの認証情報を取得できません'; return 1; }
    url="$url#token=$token"
  fi
  log "$title を開きます"
  if command -v open >/dev/null 2>&1; then open "$url"; else
    # 認証トークンを端末・ログへ表示しない。
    if [ "$title" = NanoMuse ]; then err 'Macのopenコマンドが必要です'; return 1; fi
    printf '%s\n' "$url"
  fi
}
result=0
if [ "$notes" = 1 ]; then open_ui 3000 8300 SilverBullet || result=1; fi
if [ "$web" = 1 ]; then
  if [ "$backend" = nanomuse ]; then open_ui 8787 8787 NanoMuse || result=1
  else open_ui 9119 9119 Hermes || result=1; fi
fi
if [ "$backend" = nanomuse ] && [ "$mobile" = 1 ] && { [ -t 1 ] || [ "$explicit_mobile" = 1 ]; }; then
  if ssh -o BatchMode=yes "$host" 'sudo -H -u secretary test -s /home/secretary/.config/secretary/mobile-url'; then
    log 'スマホ用QR: Tailscaleを接続して読み取ってください（認証情報を含みます）'
    ssh "$host" 'sudo -H -u secretary /opt/nanomuse/current/.venv/bin/python /opt/secretary/nanomuse-mobile.py' || result=1
  elif [ "$explicit_mobile" = 1 ]; then
    err 'スマホ用公開が未設定です。secretaryのnanomuse_portを設定してprovisionを実行してください'
    result=1
  fi
fi
exit "$result"

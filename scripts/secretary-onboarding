#!/usr/bin/env bash
# Shared first-run guide for NanoMuse, DSH and Codex. No credentials are returned.
set -uo pipefail
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=./lib.sh
source "$DIR/lib.sh"
host="${1:?usage: secretary-onboarding <host> [all|dsh|codex]}"
scope="${2:-all}"
[[ "$host" =~ ^[a-zA-Z0-9][a-zA-Z0-9._-]*$ ]] || exit 2
case "$scope" in all|dsh|codex) ;; *) exit 2 ;; esac
[ "${DEV_SECRETARY_CHECK:-1}" = 1 ] && [ "${DEV_AGENT_CHECK:-on}" != off ] || exit 0
statuses="$(ssh -o BatchMode=yes "$host" 'sudo -H -u secretary /usr/local/bin/secretary readiness' 2>/dev/null)" || {
  err '設定状態を確認できません。起動は続けます。再確認: dev secretary doctor'
  exit 0
}
pending=()
while IFS=$'\t' read -r section state label; do
  [ -n "$section" ] || continue
  if [ "$scope" = codex ] && [ "$section" != codex ]; then continue; fi
  if [ "$scope" = dsh ]; then
    case "$section" in codex|dsh-model) ;; *) continue ;; esac
  fi
  if [ "$section" = notes ] && [ "${SECRETARY_WANT_NOTES:-0}" != 1 ]; then continue; fi
  case "$section" in
    nanomuse-model)
      if [ "$state" = ready ]; then log 'NanoMuseモデル: 設定済み'; else
        log 'NanoMuseモデル: 未設定。これから開く画面の Settings → Connections でモデルとAPIキーを設定してください'
      fi
      continue ;;
    dsh-model)
      section=dsh
      if [ "$scope" = dsh ]; then
        case "$state" in
          ready) log 'DSHモデル認証: 保存済み（接続は未確認）' ;;
          missing) log 'DSH: 未導入。サーバーで ./provision/run secretary-dev を実行してください' ;;
          pending) log 'DSHモデル認証: 未設定。これから開くDSHの設定でプロバイダー・モデル・APIキーを設定してください' ;;
          *) log 'DSHモデル認証: 確認できません。これから開くDSHの設定を確認してください（独自設定は自動判定の対象外です）' ;;
        esac
        continue
      fi ;;
    codex)
      [[ " ${DEV_SKIP_AGENTS:-} " == *' codex '* ]] && continue ;;
    notes|gmail|outlook|plane|karakeep|timetree) ;;
    *) continue ;;
  esac
  case "$state" in
    ready)
      if [ "$section" = dsh ]; then log 'DSHモデル認証: 保存済み（接続は未確認）'
      elif [ "$section" = codex ]; then log 'Codex: ログイン済み'
      else log "$label: 設定済み"; fi ;;
    pending)
      case "$section" in
        codex) log 'Codex: 未ログイン' ;;
        dsh) log 'DSHモデル認証: 未設定' ;;
        *) log "$label: 未設定・停止中" ;;
      esac
      pending+=("$section") ;;
    missing) log "$label: 未導入。サーバーで ./provision/run secretary-dev を実行してください" ;;
    *) log "$label: 確認できません。dev secretary doctor で確認してください" ;;
  esac
done <<< "$statuses"
skip_dir="$HOME/.config/dev/skip-secretary/$host"
if [ -t 0 ] && [ -t 1 ]; then
  for section in "${pending[@]}"; do
    if [ "${DEV_FORCE_LOGIN:-0}" != 1 ] && [ -e "$skip_dir/$section" ]; then continue; fi
    case "$section" in
      codex) label='Codexログイン' ;;
      dsh) label='DSHモデル認証（設定画面を開く）' ;;
      *) label="$section" ;;
    esac
    printf '[dev] %s を設定しますか? [y=今する / Enter=今回は進む / s=今後聞かない] ' "$label" >&2
    read -r answer < /dev/tty || answer=''
    case "$answer" in
      y|Y)
        "$DIR/secretary-command" "$host" setup "$section" || { log "$label: 設定は完了していません。このまま進みます"; continue; }
        if [ "$section" = codex ]; then
          refreshed="$(ssh -o BatchMode=yes "$host" 'sudo -H -u secretary /usr/local/bin/secretary readiness' 2>/dev/null)"
          if printf '%s\n' "$refreshed" | awk -F '\t' '$1=="codex" && $2=="ready" {found=1} END {exit !found}'; then
            log 'Codex: ログイン済み'
          else log 'Codex: ログインを確認できません。このまま進みます'; fi
        fi ;;
      s|S)
        mkdir -p "$skip_dir"; : > "$skip_dir/$section"
        log "$label: 今後聞きません（再案内: dev --login secretary）" ;;
    esac
  done
fi
log '再案内: dev --login secretary / 個別設定: dev secretary setup codex・dsh / 診断: dev secretary doctor'
exit 0

#!/usr/bin/env bash
# Remotion Studio を、コンテナ内で起動し (未起動なら)、SSHトンネル経由でMacのブラウザに開く。失敗しても処理は止めない。
#
# Usage: open-studio <ssh-host> <remote-path> <remote-port>
# 環境変数: DEV_STUDIO_LOCAL_PORT (既定3000から空きを探す) / DEV_WEB_TUNNEL_TTL (トンネルの寿命・秒、既定14400=4時間)
#   ※ トンネルはSSH接続なので、開いている間はサーバーの自動Suspendを止める。寿命で自動的に閉じる。
#   ※ プロジェクトに package.json と node_modules が必要 (依存の導入は利用者が行う: pnpm i / npm ci)。
set -uo pipefail

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=./lib.sh
source "$DIR/lib.sh"

host="${1:?usage: open-studio <ssh-host> <remote-path> <remote-port>}"
path="${2:?usage: open-studio <ssh-host> <remote-path> <remote-port>}"
remote_port="${3:?usage: open-studio <ssh-host> <remote-path> <remote-port>}"
ttl="${DEV_WEB_TUNNEL_TTL:-14400}"

is_up() { ssh -o BatchMode=yes "$host" "curl -s -o /dev/null http://127.0.0.1:$remote_port/" 2>/dev/null; }

if ! is_up; then
  if ! ssh -o BatchMode=yes "$host" "cd $path && [ -f package.json ] && [ -d node_modules ]" 2>/dev/null; then
    err "Remotion Studio: $host:$path に package.json か node_modules がありません (プロジェクトを作るか、依存を導入してください)"
    exit 0
  fi
  log "Remotion Studio を起動します ($host:$path, port $remote_port)"
  # ssh を切っても残るよう、setsid + nohup で切り離す。ログは ~/.cache/remotion-studio.log
  # (& は npx だけに掛ける。&& の連なり全体に掛けると、サブシェルが ssh の出力を握り続けて、ssh が戻らない)
  ssh -o BatchMode=yes "$host" "mkdir -p ~/.cache && cd $path && { setsid nohup npx remotion studio --port=$remote_port --no-open >> ~/.cache/remotion-studio.log 2>&1 < /dev/null & }" </dev/null >/dev/null 2>&1 \
    || { err "Remotion Studio を起動できませんでした"; exit 0; }
  for _ in $(seq 1 30); do is_up && break; sleep 2; done
  is_up || { err "Remotion Studio が起動しません (コンテナの ~/.cache/remotion-studio.log を確認)"; exit 0; }
fi

port="$(ensure_tunnel "$host" "$remote_port" "${DEV_STUDIO_LOCAL_PORT:-3000}" "$ttl")" || exit 0
log "Remotion Studio: localhost:$port -> $host:$remote_port (${ttl}秒で自動的に閉じます)"
url="http://127.0.0.1:${port}/"
if command -v open >/dev/null 2>&1; then open "$url"; elif command -v xdg-open >/dev/null 2>&1; then xdg-open "$url"; else echo "$url"; fi
exit 0

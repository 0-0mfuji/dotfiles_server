#!/usr/bin/env bash
# 指定したリモートホスト・パスをエディタのRemote Development機能で開く。
# Usage: open-project <ssh-host> <path> [editor]
set -euo pipefail

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=./lib.sh
source "$DIR/lib.sh"

host="${1:?usage: open-project <ssh-host> <path> [editor]}"
path="${2:?usage: open-project <ssh-host> <path> [editor]}"
editor="${3:-${DEFAULT_EDITOR:-zed}}"

# `~` を含むパスはリモート側で絶対パスに解決する (Zedのssh URIは絶対パスが必要)
path="$(ssh -o BatchMode=yes "$host" "cd $path && pwd")" || { err "path not found on $host: $path"; exit 1; }

log "opening $host:$path with $editor"

case "$editor" in
  zed)
    # NOTE: ZedのRemote Development URIの仕様はバージョンにより変わる可能性がある。
    # 実際に使用しているZedのバージョンで `zed ssh://<host><path>` の挙動を確認すること。
    exec zed "ssh://${host}${path}"
    ;;
  *)
    err "unsupported editor: $editor"
    exit 1
    ;;
esac

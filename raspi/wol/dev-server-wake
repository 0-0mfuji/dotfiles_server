#!/usr/bin/env bash
# Development Serverへ Wake-on-LAN の Magic Packet を送信する。
# 管理用1GbE NIC宛に送ること (10GbE NICはWoL用途に使わない)。
# Usage: dev-server-wake <mac-address>
set -euo pipefail

mac="${1:?usage: dev-server-wake <mac-address>}"

# デフォルト経路のNICのLAN内ブロードキャストアドレス (例: 192.168.1.255) 宛に送る。
# Wi-Fi接続やDockerのブリッジが複数あっても、意図したLANへ確実に出すため。
iface="$(ip route show default | awk '{print $5; exit}')"
brd="$(ip -4 -o addr show dev "$iface" 2>/dev/null | awk '{for(i=1;i<=NF;i++) if($i=="brd") {print $(i+1); exit}}')"

if command -v wakeonlan >/dev/null 2>&1; then
  if [ -n "$brd" ]; then wakeonlan -i "$brd" "$mac"; else wakeonlan "$mac"; fi
elif command -v etherwake >/dev/null 2>&1; then
  sudo etherwake "$mac"
else
  echo "wakeonlan (or etherwake) not found; install one of them on this Raspberry Pi" >&2
  exit 1
fi
